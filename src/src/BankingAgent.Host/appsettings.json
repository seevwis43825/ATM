{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=bankingagent.db",
    "AutoMigrate": true
  },

  "CoreBank": {
    "BaseUrl": "http://localhost:5200",
    "ApiPrefix": "/api/corebank/v1",
    "TimeoutSeconds": 15
  },

  "Audit": {
    "SigningKey": "dev-only-key-change-in-production",
    "EnableChainSignature": true,
    "FilePath": "logs/audit-chain.log"
  },

  "Jwt": {
    "SigningKey": "dev-only-signing-key-change-me-in-production!!",
    "Issuer": "banking-agent",
    "Audience": "banking-agent-client",
    "ExpirationMinutes": 30
  },

  "Crypto": {
    "Mode": "Hybrid",
    "Symmetric": "Aes256Gcm",
    "KemParameterSet": "MlKem768",
    "DsaParameterSet": "MlDsa65",
    "DataEncryptionKey": "",
    "KeyId": "dev-k1",
    "RetainOldKeysDays": 7,
    "AutoRotate": false,
    "RotationDays": 90
  },

  "RateLimit": {
    "Enabled": true,
    "AuthPermitsPerMinute": 5,
    "TransferPermitsPerMinute": 20,
    "ApiPermitsPerMinute": 120,
    "ReadPermitsPerMinute": 300,
    "IpPermitsPerMinute": 600,
    "BurstCapacity": 30
  },

  "PluginSignature": {
    "RequireSignature": false,
    "AllowUnsignedInDevelopment": true,
    "Environment": "Development",
    "RequireAuthenticode": false,
    "VerifyHashAllowlist": false,
    "TrustedThumbprints": [],
    "TrustedPublicKeyTokens": [],
    "TrustedHashes": {}
  },

  "SecurityGate": {
    "Enabled": false,
    "Environment": "Development",
    "RequireHttps": false,
    "EnableHsts": false,
    "HstsMaxAgeSeconds": 31536000,
    "RemoveServerHeader": true,
    "MinTlsVersion": "TLS12",
    "RequirePluginSignature": false,
    "DisableDeveloperExceptionPage": true,
    "TrustedProxies": ""
  },

  "Plugins": {
    "Directory": ""
  }
}
