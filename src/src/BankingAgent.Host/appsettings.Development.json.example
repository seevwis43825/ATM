{
  // ===== 开发环境配置模板 =====
  //
  // 用法：
  //   copy appsettings.Development.json.example appsettings.Development.json
  //
  // 为什么 appsettings.Development.json 不入库：
  //   它存放开发用密钥材料。曾经把真实 AES-256 密钥提交进仓库，
  //   等于把数据加密主密钥公开 —— 这类泄漏无法靠"以后删掉"补救，
  //   必须从第一次提交起就不入库。
  //
  // 密钥可以全部留空：
  //   留空时宿主在 Development 下会使用确定性的开发密钥并打印警告，
  //   保证 clone 下来即可运行（见 BankingCoreServiceCollectionExtensions 与 AuditSigningKeyPolicy）。
  //   生产环境不会走这条兜底路径：审计链签名密钥为空会在**启动期**直接拒绝启动
  //   （Program.cs 的硬校验），其余密钥由 SecurityGate 拦截。

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // AES-256-GCM 主密钥，必须是 32 字节的 Base64。
  // 生成方式（PowerShell）：
  //   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
  "Crypto": {
    "Mode": "Hybrid",
    "DataEncryptionKey": "",
    "KeyId": "dev-k1"
  },

  // HS256 要求至少 32 字节，否则 TokenService 构造即失败
  "Jwt": {
    "SigningKey": ""
  },

  // 审计链 HMAC 密钥。
  // ⚠️ 留空 = 「未配置」：Development 下沿用公开的开发默认密钥；
  //    非 Development 下**启动即失败**（空密钥等于审计链可被任意伪造）。
  "Audit": {
    "SigningKey": ""
  },

  // ===== 大模型接入（可选）=====
  // 留空即走规则表，系统照常运行；填入密钥后意图识别改由大模型判定。
  // 也可以完全不用本文件，直接用环境变量：Ai__ApiKey / Ai__Model / Ai__BaseUrl
  // 注意：送模型前会对用户输入做强制脱敏（账号/手机号/身份证），见 LlmIntentClassifier。
  "Ai": {
    "Enabled": true,
    "BaseUrl": "https://api.deepseek.com/v1",
    "Model": "deepseek-chat",
    "ApiKey": ""
  },

  "SecurityGate": {
    "Enabled": false,
    "Environment": "Development",
    "RequireHttps": false,
    "EnableHsts": false,
    "DisableDeveloperExceptionPage": true
  },

  "PluginSignature": {
    "Environment": "Development",
    "AllowUnsignedInDevelopment": true
  }
}