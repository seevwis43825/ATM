{
  "Urls": "http://localhost:5200",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "MockBank": {
    // 故障注入开关（X-Mock-Scenario 请求头）。
    //
    // 默认 false：非 Development 环境一律忽略注入请求头。
    // 原因：故障注入等于"一个请求头就能让所有转账失败、或强制 3 秒延迟"，
    // 一旦被他人访问到就是可滥用的可用性攻击面。
    //
    // Development 环境无需该开关，自动允许（本地演示与端到端测试依赖它）。
    // 若确实需要在非开发环境演示故障场景，显式改为 true 并确保网络隔离。
    "EnableFaultInjection": false,

    // ===== 多银行核心系统配置 =====
    // 每个被模拟的银行拥有**自己的数据库文件**，落在 DataDirectory 下：
    //   mockbank_icbc.db  中国工商银行
    //   mockbank_ccb.db   中国建设银行
    //   mockbank_cmb.db   招商银行
    // Banks 留空表示启用目录中的全部银行；可填 ["ICBC","CCB"] 只启用部分行。
    //
    // 目录名用 App_Data 而不是 data：Windows 大小写不敏感，data 会命中源码目录 Data/，
    // 把运行期数据库写进源码树；Linux 上两者却是不同目录，两端行为不一致。
    "DataDirectory": "App_Data",

    // 启动时是否重建全部银行数据库。
    // 默认 false —— 数据在重启后保留，更像真实核心系统。
    // 需要干净演示数据时调用 POST /api/corebank/v1/_admin/reset，
    // 或先停掉 MockBank 进程、再删除 App_Data/ 下的 .db / .db-wal / .db-shm 文件。
    "ResetOnStartup": false,

    "Banks": []
  }
}
