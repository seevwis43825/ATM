<Solution>
  <Folder Name="/src/">
    <Project Path="src/BankingAgent.Plugin.Sdk/BankingAgent.Plugin.Sdk.csproj" />
    <Project Path="src/BankingAgent.Base/BankingAgent.Base.csproj" />
    <Project Path="src/BankingAgent.Host/BankingAgent.Host.csproj" />
  </Folder>
  <Folder Name="/mock-bank/">
    <Project Path="mock-bank/MockBank.Api/MockBank.Api.csproj" />
  </Folder>
  <Folder Name="/plugins/">
    <Project Path="plugins/BankingAgent.Plugin.Transfer/BankingAgent.Plugin.Transfer.csproj" />
    <Project Path="plugins/BankingAgent.Plugin.BillAnalysis/BankingAgent.Plugin.BillAnalysis.csproj" />
    <Project Path="plugins/BankingAgent.Plugin.CardManagement/BankingAgent.Plugin.CardManagement.csproj" />
  </Folder>
  <!--
    测试项目必须进解决方案：
    CI 之前引用它们做 dotnet test，但它们不在 slnx 里，
    导致「本地能过、CI 从来测不到」。E2ETest 与 StressTest 需要运行中的
    Mock Bank(:5200) 与宿主(:5243)，由 CI 的 integration 作业单独启动后调用，
    因此同样纳入编译范围，保证签名变化时不会漏改。
  -->
  <Folder Name="/tests/">
    <Project Path="UnitTests/UnitTests.csproj" />
    <Project Path="E2ETest/E2ETest.csproj" />
    <Project Path="StressTest/StressTest.csproj" />
    <Project Path="LoadTest/LoadTest.csproj" />
    <Project Path="CryptoSelfTest/CryptoSelfTest.csproj" />
  </Folder>
</Solution>
