# 环境变量模板
# 用法：cp .env.example .env  然后按需填写
# 全部留空也能运行（MOCK_MODE=true 时所有工具返回预置数据）

# 是否使用 Mock 模式（新组员建议先 true，跑通流程后再改 false）
MOCK_MODE=true

# ===== AI 模型配置（可选，Mock 模式下不需要）=====
# 如果你用的是 DeepSeek / 通义 / OpenAI 兼容接口，填这里
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# ===== 服务配置 =====
API_PORT=3001
WEB_PORT=5173

# ===== 数据库（第一版用不上，留位）=====
DATABASE_URL=

# ===== 安全相关 =====
# 敏感操作（转账、赎回、挂失）是否强制二次确认，演示时必须 true
REQUIRE_CONFIRM=true
# 审计日志保留天数
AUDIT_RETENTION_DAYS=90
